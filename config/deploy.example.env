# Copy to config/deploy.local.env (gitignored) to choose how snowbridge-files runs. Nothing here is required: without it,
# deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   the service in the foreground on 127.0.0.1, no systemd, no cluster
#   host  the existing rootful container, via a user unit (deploy/host/install-host-unit.sh)
#   k3s   a pod in K3s behind a loopback forwarder, so the front end keeps its address
SNOWBRIDGE_FILES_DEPLOY_MODE=dev

# k3s mode only: folder-icon switches handed to the pod (absent means off).
# SNOWBRIDGE_FILES_AI_FOLDER_ICONS=false
# SNOWBRIDGE_FILES_AI_FOLDER_ICONS_MODEL=qwen3:14b
# SNOWBRIDGE_FILES_AI_FOLDER_ICONS_PREFETCH_USER=
